# Copy to .env and adjust. No real credentials belong in this file.
DATABASE_URL="postgresql://viberoom:viberoom@localhost:5432/viberoom?schema=public"
PORT=4000
# Public base URL clients use to reach this server (LAN IP when testing on phones)
PUBLIC_BASE_URL="http://localhost:4000"
CORS_ORIGIN="*"
# Session lifetime in days
SESSION_TTL_DAYS=30
# Optional music providers (leave blank to keep them disabled)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=
