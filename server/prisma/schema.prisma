generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoomVisibility { PUBLIC PRIVATE LOCAL }
enum RoomRole { HOST MODERATOR MEMBER }
enum QueuePolicy { ANYONE_CAN_ADD MODERATORS_ONLY }
enum QueueStatus { QUEUED PLAYING PLAYED REMOVED }
enum PlayState { PLAYING PAUSED STOPPED }
enum FriendStatus { PENDING ACCEPTED BLOCKED }
enum KaraokeStatus { LOBBY ACTIVE PAUSED ENDED }
enum DuetRole { SINGER_A SINGER_B }
enum DuetInviteStatus { INVITED ACCEPTED DECLINED }

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  displayName  String
  passwordHash String
  avatarColor  String   @default("#8B5CF6")
  bio          String?
  createdAt    DateTime @default(now())

  sessions        AuthenticationSession[]
  passwordResets  PasswordReset[]
  roomMemberships RoomMember[]
  hostedRooms     Room[]            @relation("RoomHost")
  queueItems      QueueItem[]
  votes           QueueVote[]
  playlists       Playlist[]
  favorites       UserFavorite[]
  history         ListeningHistory[]
  notifications   Notification[]
  friendsSent     Friend[]          @relation("FriendRequester")
  friendsReceived Friend[]          @relation("FriendAddressee")
  duetParticipations DuetParticipant[]
}

model AuthenticationSession {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Friend {
  id           String       @id @default(cuid())
  requesterId  String
  addresseeId  String
  status       FriendStatus @default(PENDING)
  createdAt    DateTime     @default(now())
  requester    User         @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee    User         @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
}

model MusicProvider {
  id          String       @id          // e.g. "demo", "spotify"
  name        String
  canStream   Boolean      @default(false)
  enabled     Boolean      @default(true)
  tracks      MusicTrack[]
}

// Catalog metadata cache. audioPath is only set for providers whose terms allow
// direct playback (our own demo catalog). It is a stored asset path, not a
// temporary signed URL.
model MusicTrack {
  id           String   @id @default(cuid())
  providerId   String
  providerTrackId String
  title        String
  artist       String
  album        String?
  durationMs   Int
  artworkUrl   String?
  genre        String?
  audioPath    String?
  isKaraoke    Boolean  @default(false)
  createdAt    DateTime @default(now())

  provider     MusicProvider @relation(fields: [providerId], references: [id])
  queueItems   QueueItem[]
  playlistTracks PlaylistTrack[]
  favorites    UserFavorite[]
  history      ListeningHistory[]

  @@unique([providerId, providerTrackId])
  @@index([title])
  @@index([artist])
}

model Playlist {
  id        String   @id @default(cuid())
  userId    String
  name      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tracks    PlaylistTrack[]

  @@index([userId])
}

model PlaylistTrack {
  id         String   @id @default(cuid())
  playlistId String
  trackId    String
  position   Int
  addedAt    DateTime @default(now())
  playlist   Playlist   @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  track      MusicTrack @relation(fields: [trackId], references: [id])

  @@unique([playlistId, trackId])
  @@index([playlistId, position])
}

model Room {
  id            String         @id @default(cuid())
  code          String         @unique
  name          String
  description   String?
  visibility    RoomVisibility @default(PUBLIC)
  passwordHash  String?
  requireApproval Boolean      @default(false)
  maxMembers    Int            @default(20)
  queuePolicy   QueuePolicy    @default(ANYONE_CAN_ADD)
  voteOrdering  Boolean        @default(false)
  hostId        String
  createdAt     DateTime       @default(now())
  closedAt      DateTime?

  host          User           @relation("RoomHost", fields: [hostId], references: [id])
  members       RoomMember[]
  queue         QueueItem[]
  playback      PlaybackSession?
  karaokeSessions KaraokeSession[]

  @@index([visibility, closedAt])
}

model RoomMember {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  role      RoomRole @default(MEMBER)
  joinedAt  DateTime @default(now())
  room      Room     @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([roomId, userId])
  @@index([userId])
}

model QueueItem {
  id         String      @id @default(cuid())
  roomId     String
  trackId    String
  addedById  String
  position   Int
  status     QueueStatus @default(QUEUED)
  addedAt    DateTime    @default(now())
  room       Room        @relation(fields: [roomId], references: [id], onDelete: Cascade)
  track      MusicTrack  @relation(fields: [trackId], references: [id])
  addedBy    User        @relation(fields: [addedById], references: [id])
  votes      QueueVote[]

  @@index([roomId, status, position])
}

model QueueVote {
  id          String   @id @default(cuid())
  queueItemId String
  userId      String
  value       Int      // +1 or -1
  createdAt   DateTime @default(now())
  queueItem   QueueItem @relation(fields: [queueItemId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([queueItemId, userId])
}

// One row per room: the authoritative playback clock.
// positionMs is the position at updatedAt; clients extrapolate while PLAYING.
model PlaybackSession {
  roomId       String    @id
  queueItemId  String?
  state        PlayState @default(STOPPED)
  positionMs   Int       @default(0)
  updatedAt    DateTime  @default(now())
  playerUserId String?   // the designated host-player device owner
  version      Int       @default(0)
  room         Room      @relation(fields: [roomId], references: [id], onDelete: Cascade)
}

model KaraokeSession {
  id        String        @id @default(cuid())
  roomId    String
  trackId   String
  status    KaraokeStatus @default(LOBBY)
  startedAt DateTime?
  createdAt DateTime      @default(now())
  room      Room          @relation(fields: [roomId], references: [id], onDelete: Cascade)
  participants DuetParticipant[]

  @@index([roomId])
}

model DuetParticipant {
  id        String           @id @default(cuid())
  sessionId String
  userId    String
  role      DuetRole
  status    DuetInviteStatus @default(INVITED)
  session   KaraokeSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
}

model UserFavorite {
  id      String @id @default(cuid())
  userId  String
  trackId String
  createdAt DateTime @default(now())
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  track   MusicTrack @relation(fields: [trackId], references: [id])

  @@unique([userId, trackId])
}

model ListeningHistory {
  id       String   @id @default(cuid())
  userId   String
  trackId  String
  roomId   String?
  playedAt DateTime @default(now())
  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  track    MusicTrack @relation(fields: [trackId], references: [id])

  @@index([userId, playedAt])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  payload   Json
  readAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
