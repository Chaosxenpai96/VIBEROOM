{
  "expo": {
    "name": "VibeRoom",
    "slug": "viberoom",
    "version": "0.1.0",
    "scheme": "viberoom",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B12",
    "icon": "./assets/icon.png",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "VibeRoom uses the microphone for karaoke."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0B12",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      ["expo-camera", { "cameraPermission": "VibeRoom uses the camera to scan room QR codes.", "barcodeScannerEnabled": true }],
      ["expo-audio", { "enableBackgroundPlayback": true }]
    ]
  }
}
